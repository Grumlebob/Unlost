<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.FlowPane?>


<AnchorPane prefHeight="154.0" prefWidth="419.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="bfst22.controller.FileBrowserController">
   <children>
      <FlowPane alignment="CENTER" prefHeight="164.0" prefWidth="419.0">
         <children>
            <FlowPane prefHeight="81.0" prefWidth="378.0">
               <children>
                  <Label prefHeight="17.0" prefWidth="375.0" text="Filepath:">
                     <FlowPane.margin>
                        <Insets bottom="2.0" />
                     </FlowPane.margin>
                  </Label>
                  <TextField fx:id="filePathField" prefHeight="25.0" prefWidth="311.0" />
                  <Button fx:id="browseButton" mnemonicParsing="false" onAction="#onBrowse" text="Browse...">
                     <FlowPane.margin>
                        <Insets left="5.0" />
                     </FlowPane.margin>
                  </Button>
               </children>
            </FlowPane>
            <FlowPane alignment="TOP_CENTER" prefHeight="26.0" prefWidth="399.0">
               <children>
                  <Button fx:id="okButton" mnemonicParsing="false" onAction="#onOK" text="OK" />
                  <Button fx:id="cancelButton" mnemonicParsing="false" onAction="#onCancel" text="Cancel">
                     <FlowPane.margin>
                        <Insets left="5.0" />
                     </FlowPane.margin>
                  </Button>
               </children>
            </FlowPane>
         </children>
      </FlowPane>
   </children>
</AnchorPane>
